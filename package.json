{
  "name": "tongwei-zhiy药",
  "version": "0.1.0",
  "private": true,
  "description": "通微智药：中药相关膜蛋白分子机制探究",
  "scripts": {
    "dev": "node scripts/taro.cjs build --type h5 --watch",
    "dev:h5": "node scripts/taro.cjs build --type h5 --watch",
    "dev:weapp": "node scripts/taro.cjs build --type weapp --watch",
    "build": "npm run build:h5 && npm run build:weapp",
    "build:h5": "node scripts/taro.cjs build --type h5",
    "build:weapp": "node scripts/taro.cjs build --type weapp",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tarojs/components": "4.1.5",
    "@tarojs/helper": "4.1.5",
    "@tarojs/plugin-framework-react": "4.1.5",
    "@tarojs/plugin-platform-h5": "4.1.5",
    "@tarojs/plugin-platform-weapp": "^4.1.5",
    "@tarojs/react": "^4.1.5",
    "@tarojs/runtime": "4.1.5",
    "@tarojs/shared": "4.1.5",
    "@tarojs/taro": "4.1.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.24.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@tarojs/cli": "4.1.5",
    "@tarojs/webpack5-runner": "4.1.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "babel-preset-taro": "^4.1.5",
    "react-refresh": "^0.14.2",
    "sass": "^1.77.8",
    "typescript": "5.6.3"
  }
}
